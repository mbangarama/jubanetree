@model JubaneTree.Models.Member

<div class="family-card add-member-card">

    <div class="add-member-header">

        <div class="add-member-icon">
            <span class="glyphicon glyphicon-user"></span>
        </div>

        <div>
            <h2>Add Child</h2>

            <p>
                Add a new member to this branch of the family tree.
            </p>
        </div>

    </div>


    @using (Html.BeginForm(
        "CreateChild",
        "Home",
        FormMethod.Post,
        new
        {
            enctype = "multipart/form-data",
            id = "createChildForm"
        }))
    {
        @Html.AntiForgeryToken()

        // The selected parent's Member ID
        @Html.HiddenFor(model => model.id)

        @Html.HiddenFor(model => model.FamilyCode)


        @Html.ValidationSummary(
            true,
            "",
            new { @class = "alert alert-danger" }
        )


        <!-- ======================================== -->
        <!-- PERSONAL DETAILS                         -->
        <!-- ======================================== -->

        <div class="form-section">

            <div class="form-section-title">
                <span class="glyphicon glyphicon-user"></span>
                Personal details
            </div>


            <div class="row">

                <!-- TITLE -->

                <div class="col-sm-3">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Title)

                        @Html.DropDownListFor(
                            model => model.Title,
                            new SelectList(
                                new[]
                                {
                                    "Mr",
                                    "Mrs",
                                    "Miss",
                                    "Ms",
                                    "Dr"
                                }
                            ),
                            "Select title",
                            new
                            {
                                @class = "form-control"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Title,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- FIRST NAME -->

                <div class="col-sm-4">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Name)

                        @Html.TextBoxFor(
                            model => model.Name,
                            new
                            {
                                @class = "form-control",
                                placeholder = "First name"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Name,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- SURNAME -->

                <div class="col-sm-5">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Surname)

                        @Html.TextBoxFor(
                            model => model.Surname,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Surname"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Surname,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>

            </div>


            <div class="row">

                <!-- DATE OF BIRTH -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.DateOfBirth,
                            "Date of birth"
                        )

                        <div class="input-group">

                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>

                            @Html.TextBoxFor(
                                model => model.DateOfBirth,
                                "{0:dd/MM/yyyy}",
                                new
                                {
                                    @class = "form-control",
                                    id = "DateOfBirth",
                                    placeholder = "DD/MM/YYYY",
                                    autocomplete = "off"
                                }
                            )

                        </div>

                        @Html.ValidationMessageFor(
                            model => model.DateOfBirth,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- LIVING STATUS -->

                <div class="col-sm-6">

                    <div class="form-group">

                        <label>Status</label>

                        <div class="checkbox family-checkbox">

                            <label>

                                @Html.CheckBox(
                                    "IsAlive",
                                    Model.IsAlive ?? false,
                                    new
                                    {
                                        @class = "form-check-input"
                                    }
                                )

                                This person is living

                            </label>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ======================================== -->
        <!-- CONTACT DETAILS                          -->
        <!-- ======================================== -->

        <div class="form-section">

            <div class="form-section-title">
                <span class="glyphicon glyphicon-earphone"></span>
                Contact details
            </div>


            <div class="row">

                <!-- MOBILE -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Mobile)

                        @Html.TextBoxFor(
                            model => model.Mobile,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Mobile number"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Mobile,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- TELEPHONE -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Telephone)

                        @Html.TextBoxFor(
                            model => model.Telephone,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Telephone number"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Telephone,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>

            </div>


            <div class="row">

                <!-- EMAIL -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Email)

                        @Html.TextBoxFor(
                            model => model.Email,
                            new
                            {
                                @class = "form-control",
                                type = "email",
                                placeholder = "Email address"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Email,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- COUNTRY -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Country)

                        @Html.TextBoxFor(
                            model => model.Country,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Country"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Country,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>

            </div>


            <!-- ADDRESS -->

            <div class="form-group">

                @Html.LabelFor(model => model.Address)

                @Html.TextAreaFor(
                    model => model.Address,
                    new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = "Address"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.Address,
                    "",
                    new { @class = "text-danger" }
                )

            </div>

        </div>


        <!-- ======================================== -->
        <!-- EMPLOYMENT                               -->
        <!-- ======================================== -->

        <div class="form-section">

            <div class="form-section-title">
                <span class="glyphicon glyphicon-briefcase"></span>
                Employment
            </div>


            <div class="row">

                <!-- JOB -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Job)

                        @Html.TextBoxFor(
                            model => model.Job,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Occupation"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Job,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- COMPANY -->

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Company)

                        @Html.TextBoxFor(
                            model => model.Company,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Company"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Company,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>

            </div>

        </div>


        <!-- ======================================== -->
        <!-- PROFILE PHOTO                            -->
        <!-- ======================================== -->

        <div class="form-section">

            <div class="form-section-title">
                <span class="glyphicon glyphicon-camera"></span>
                Profile photo
            </div>


            <div class="photo-upload">

                <div class="photo-placeholder"
                     id="photoPreview">

                    <span class="glyphicon glyphicon-user"></span>

                </div>


                <div>

                    <label for="Avatar"
                           class="btn btn-default">

                        <span class="glyphicon glyphicon-camera"></span>
                        Choose photo

                    </label>


                    <input type="file"
                           id="Avatar"
                           name="upload"
                           accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                           style="display:none;" />


                    <p id="selectedFileName"
                       class="help-block">

                        JPG or PNG image

                    </p>

                </div>

            </div>

        </div>


        <!-- ======================================== -->
        <!-- ACTIONS                                  -->
        <!-- ======================================== -->

        <div class="form-actions">

            <button type="button"
                    class="btn btn-default"
                    id="cancelAddChild">

                <span class="glyphicon glyphicon-remove"></span>
                Cancel

            </button>


            <button type="submit"
                    class="btn btn-family">

                <span class="glyphicon glyphicon-plus"></span>
                Add Child

            </button>

        </div>

    }

</div>